# ==============================================================================
#  大炎 · 四大机制事件链（骨架）
#  · yan_sui.1 岁兽苏醒度进入警戒      yan_sui.2 岁兽之乱（触顶灾难）
#  · yan_sui.3 书刀案（完整度 < 50）   yan_sui.4 代理人离心（信任 < 20）
#  · yan_sui.10 岁陵决战结算           yan_sui.11 启动不反
#  · 目前每条只给「提示 + 结果」，完整事件链后续再填
# ==============================================================================

add_namespace = yan_sui

# 岁兽苏醒度进入警戒
country_event = {
	id = yan_sui.1
	title = yan_sui.1.t
	desc = yan_sui.1.d

	is_triggered_only = yes

	option = {
		name = yan_sui.1.a
		add_political_power = -25
	}
}

# 岁兽之乱
country_event = {
	id = yan_sui.2
	title = yan_sui.2.t
	desc = yan_sui.2.d

	is_triggered_only = yes

	option = {
		name = yan_sui.2.a
		add_stability = -0.05
	}
}

# 书刀案
country_event = {
	id = yan_sui.3
	title = yan_sui.3.t
	desc = yan_sui.3.d

	is_triggered_only = yes

	option = {
		name = yan_sui.3.a
		add_political_power = -50
	}
}

# 代理人离心
country_event = {
	id = yan_sui.4
	title = yan_sui.4.t
	desc = yan_sui.4.d

	is_triggered_only = yes

	option = {
		name = yan_sui.4.a
		add_to_variable = { yan_agent_trust = 5 }
	}
}

# 岁陵决战（国策 YAN_Suiling_Decisive 触发）
country_event = {
	id = yan_sui.10
	title = yan_sui.10.t
	desc = yan_sui.10.d

	is_triggered_only = yes

	option = {
		name = yan_sui.10.a
	}

	option = {
		name = yan_sui.10.b
		add_war_support = 0.05
	}
}

# 启动不反（决议 YAN_decision_launch_bufan 触发）
country_event = {
	id = yan_sui.11
	title = yan_sui.11.t
	desc = yan_sui.11.d

	is_triggered_only = yes

	option = {
		name = yan_sui.11.a
	}
}

# ============================================================================
# 乌萨斯帝国 ·「费奥多尔初步改革」决议分类页顶部的面板
# ============================================================================
#
# 挂在分类 URS_dr_reform_decisions 上（common/decisions/categories/URS_dream_categories.txt
# 的 scripted_gui = URS_dr_reform_gui），绑定在
# common/scripted_guis/URS_Feodor_Reform_GUI.txt。
#
# 控件名是两边唯一的接口，拼错不会报错、只会得到一个死控件：
#   进度条四条 URS_dr_reform_row{i}_bar，对应 scripted_gui 的 properties.frame。
#   对账脚本 docs/validate_urs_dr_reform.js。
#
# 版式：文字左起 x=10，进度条 x=124（贴图 176x32），百分比 x=306，效率 x=350。
# 右边沿 500，与「帝国宫廷」面板（482）同一量级，超出会被分类页裁掉。
# ============================================================================
guiTypes = {
	containerWindowType = {
		name = "URS_dr_reform_window"
		size = { width = 100% height = 400 }
		position = { x = 0 y = 0 }

		instantTextBoxType = {
			name = "URS_dr_reform_title"
			position = { x = 10 y = -10 }
			maxWidth = 500
			maxHeight = 34
			format = center
			font = "hoi_36header"
			text = "URS_dr_reform_title_text"
		}


		texturefile = "gfx/interface/REU_ludmila_office/ui_entrybg.png"
		legacy_lazy_load = no
	}

	# ===== 按钮 =====
	# 注意：用最简 spriteType（无 effectFile / noOfFrames）。
	# effectFile=buttonstate.lua 是按钮「多帧状态机」效果，配合单帧贴图会让引擎
	# 无法正确生成按钮渲染帧与命中区域 → 白底不显示、点击失效（预览绕过 effect 才正常）。
	# vanilla 单帧按钮（如 GFX_dog、GFX_closebutton）一律用 spriteType。
	spriteType = {
		name = "GFX_REU_Lud_choice_btn"
		texturefile = "gfx/interface/REU_ludmila_office/ui_choice.png"
		legacy_lazy_load = no

			"gfx/fonts/hoi_30header"
		}
		color = 0xff2a2620
		textcolors = {
			G = { 44 96 62 }
			B = { 40 88 158 }
			Y = { 146 96 10 }
			R = { 176 28 40 }
			H = { 146 96 10 }
			X = { 96 90 82 }
			W = { 42 38 32 }
			T = { 253 247 236 }
		}
	}
	bitmapfont_override = {
		name = "YAN_Mir_title26"
		fontfiles = {
			"gfx/fonts/hoi_30header"
			"gfx/fonts/Arial_26s"
		}

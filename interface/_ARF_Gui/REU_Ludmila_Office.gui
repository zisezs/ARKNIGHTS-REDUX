guiTypes = {

	# ======================================================================
	# 柳德米拉的主席办公室 —— GALgame 风格对话面板
	#  · 由 common/scripted_guis/REU_Ludmila_Office.txt 驱动
	#  · 显示条件：国家旗标 REU_ludmila_office_open
	#  · 布局约定：窗口 1200x700；浅灰底板 + 深墨字（自建 *d 字体）
	#    后写的控件压在先写的上面，所以「点任意处继续」要放在选项/互动按钮之前
	# ======================================================================
	containerWindowType = {
		name = "REU_Ludmila_Office_Window"
		position = { x = 0 y = 0 }
		size = { width = 1200 height = 700 }
		orientation = center
		origo = center
		moveable = no
		click_to_front = yes

		background = {
			name = "Background"
			quadTextureSprite = "GFX_REU_Lud_bg"
		}

		# ---- 场景层：全屏底图，按 REU_ludmila_scene 切（0 = 主席办公室 / 1 = 1095 年谷仓） ----
		# 窗口的 background 仍是办公室（兜底），这一层盖在上面并按需切换
		iconType = {
			name = "REU_Lud_Scene"
			position = { x = 0 y = 0 }
			spriteType = "GFX_REU_Lud_bg"
			alwaystransparent = yes
		}

		# ---- 选项出现时压暗背景的遮罩（仅在选项模式可见） ----
		iconType = {
			name = "REU_Lud_Dim"
			position = { x = 0 y = 0 }
			spriteType = "GFX_REU_Lud_dim"
			alwaystransparent = yes
		}

		# ---- 立绘（差分由 scripted_gui 的 properties.image 动态切换） ----
		# 主角（玩家·心腹）：左侧、略小一档拉开纵深；写在她的立绘之前 = 压在下面
		iconType = {
			name = "REU_Lud_Portrait_Prota"
			position = { x = 14 y = 88 }
			spriteType = "GFX_REU_Lud_prota"
			alwaystransparent = yes
		}

		iconType = {
			name = "REU_Lud_Portrait"
			position = { x = 380 y = 40 }
			spriteType = "GFX_REU_Lud_uniform"
			alwaystransparent = yes
		}

		# ---- 左上角地点标题（带描边底板） ----
		iconType = {
			name = "REU_Lud_Title_Bg"
			position = { x = 24 y = 14 }
			spriteType = "GFX_REU_Lud_titlebg"
			alwaystransparent = yes
		}

		instantTextBoxType = {
			name = "REU_Lud_Title"
			position = { x = 44 y = 22 }
			font = "REU_Lud_title26d"
			text = "[REU_GetLudmilaTitle]"
			maxWidth = 280
			maxHeight = 34
			fixedsize = yes
			format = left
			alwaystransparent = yes
		}

		# ---- 对话框（浅灰底，正文深墨色）----
		iconType = {
			name = "REU_Lud_TextBox"
			position = { x = 0 y = 566 }
			spriteType = "GFX_REU_Lud_textbox"
			alwaystransparent = yes
		}

		# 说话人名牌：底边与对话框上沿齐平
		iconType = {
			name = "REU_Lud_Plate"
			position = { x = 24 y = 514 }
			spriteType = "GFX_REU_Lud_plate"
			alwaystransparent = yes
		}

		instantTextBoxType = {
			name = "REU_Lud_Speaker"

	# 透明点击层（盖在刻度条 / 调性拨片上，只吃鼠标不吃画面）
	spriteType = {
		name = "GFX_LTN_law_clickbar"
		texturefile = "gfx/interface/LTN_law/LTN_law_clickbar.png"

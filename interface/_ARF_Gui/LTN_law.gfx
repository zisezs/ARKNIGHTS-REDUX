# ==============================================================================
#  莱塔尼亚 ·「金律乐章 · 调律台」 —— 贴图与字体注册
#
#  贴图由 docs/gen_ltn_law_assets.cjs 程序化生成（无 AI 生图），
#  产物目录 gfx/interface/LTN_law/。**手改会被覆盖。**
#
#  ⚠️ iconType / buttonType 没有 size 键：显示尺寸 = 贴图原生尺寸。
#  ⚠️ 多帧贴图一律横向排布：noOfFrames = N ⇒ 单帧宽 = 图宽 / N，
#     帧号与面板变量一一对应（见 interface/_ARF_Gui/LTN_law.gui）。
#  ⚠️ 面板是深色底 → 这里另开一套浅色字体（LTN_law_*），
#     不要沿用 YAN_Col_*（那是深字配宣纸白）。
# ==============================================================================

spriteTypes = {

	spriteType = {
		name = "GFX_LTN_law_bg"
		texturefile = "gfx/interface/LTN_law/LTN_law_bg.png"
		noOfFrames = 1
	}
	# 音孔刻度条：帧 0..4 = 点亮 0..4 段
	spriteType = {
		name = "GFX_LTN_law_bar"
		texturefile = "gfx/interface/LTN_law/LTN_law_bar.png"
		noOfFrames = 5
	}
	# 调性拨片：帧 0 = 宽容 / 帧 1 = 严苛
	spriteType = {
		name = "GFX_LTN_law_tone"
		texturefile = "gfx/interface/LTN_law/LTN_law_tone.png"
		noOfFrames = 2
	}

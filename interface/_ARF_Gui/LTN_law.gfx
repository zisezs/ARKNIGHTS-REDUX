	}

	# 民族精神【金律的和谐】图标
	spriteType = {
		name = "GFX_idea_LTN_dyn_law_harmony"
		texturefile = "gfx/interface/LTN_law/LTN_law_idea.png"
		noOfFrames = 1
	}


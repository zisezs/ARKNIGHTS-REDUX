		texturefile = "gfx/interface/REU_sokolov_training/close_btn.png"
		legacy_lazy_load = no
	}

	# ---- 进度条：11 帧（0 = 空，10 = 满），用 frame = REU_sel_<skill>_lv 切换 ----
	spriteType = {
		name = "GFX_REU_Sokolov_bar"
		texturefile = "gfx/interface/REU_sokolov_training/bar_11.png"
		noOfFrames = 11
		legacy_lazy_load = no
	}

	# ---- 四枚技能行图标（56x56 矢量）----
	spriteType = {
		name = "GFX_REU_Sokolov_icon_scout"
		texturefile = "gfx/interface/REU_sokolov_training/icon_scout.png"
		legacy_lazy_load = no
	}
	spriteType = {
		name = "GFX_REU_Sokolov_icon_night"
		texturefile = "gfx/interface/REU_sokolov_training/icon_night.png"
		legacy_lazy_load = no
	}
	spriteType = {
		name = "GFX_REU_Sokolov_icon_intel"
		texturefile = "gfx/interface/REU_sokolov_training/icon_intel.png"
		legacy_lazy_load = no
	}
	spriteType = {
		name = "GFX_REU_Sokolov_icon_blade"
		texturefile = "gfx/interface/REU_sokolov_training/icon_blade.png"
		legacy_lazy_load = no
	}

	# ---- 侧栏头像：直接引用角色文件里的同一张贴图（原生 156x210）----
	#   与 common/characters/REU.txt 的 army/civilian.large 同源；换人的图随角色文件走。
	spriteType = {
		name = "GFX_REU_portrait_sokolov"
		texturefile = "gfx/leaders/REU/Sokolov.dds"
		legacy_lazy_load = no
	}
	spriteType = {
		name = "GFX_REU_portrait_yelena"
		texturefile = "gfx/leaders/REU/Yelena_stage_1.png"
		legacy_lazy_load = no
	}
	spriteType = {
		name = "GFX_REU_portrait_alina"
		texturefile = "gfx/leaders/REU/Alina_stage_1.png"
		legacy_lazy_load = no
	}
	spriteType = {
		name = "GFX_REU_portrait_mudrock"
		texturefile = "gfx/leaders/REU/Mudrock.png"
		legacy_lazy_load = no
	}
}

bitmapfonts = {

	# 深钢底需要**浅字**：REU_Lud_title26 / text20 / text16 定义在

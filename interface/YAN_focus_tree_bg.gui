# 大炎 · 国策树页面底图窗口
# 由 common/scripted_guis/YAN_focus_tree_bg.txt 在 national_focus_context 下挂到
# interface/nationalfocusview.gui 里 tree 的第一个子容器 yan_focus_bg_anchor。
# 锚点排在 grid_window 之前 → 底图画在国策节点下面，同时保留 tree 原有底图（滚轮缩放/拖动正常）。
# 窗口按 100% 铺满锚点，GFX_YAN_focus_tree_bg 是 borderSize 0 的 corneredTile，会整张拉伸，
# 所以 2560x1440 贴图在 1080p/1440p 窗口里都能占满且保持清晰。

guiTypes = {
	containerWindowType = {
		name = "yan_focus_tree_bg_window"
		position = { x = 0 y = 0 }
		size = { width = 100%% height = 100%% }
		clipping = no

		background = {
			name = "background"
			quadTextureSprite = "GFX_YAN_focus_tree_bg"
			alwaystransparent = yes
		}
	}
}

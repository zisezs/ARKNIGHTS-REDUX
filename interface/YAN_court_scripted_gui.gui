# 大炎 ·「宰府朝议」面板版面（照原版 GER_inner_circle_scripted_gui 重建）：真龙座 + 12 席已就任者
# 生成器：E:/tmp/sui12/gen_court.js（改数据表重跑，勿手改产物）
# 注意：containerWindowType 的 size 只能写 width/height

# 席位几何 = 原版 GER 三席版式 × 0.7（贴图已预缩到 0.7，见 gen_court_panel_art.js；gui 里不写 scale）
@YAN_SEAT_W = 112
# 席位容器高 = 头像框底边（84）：instantTextBoxType 的 center_down 是「顶边贴父容器底 + y」，名牌/特质文字才落得准
@YAN_SEAT_H = 84
@YAN_TEXT_X = -56

guiTypes = {
	containerWindowType = {
		name = "yan_court_ui_window"
		orientation = lower_left
		position = { x = 0 y = 0 }
		size = { width = 600 height = 700 }
		clipping = no

		background = {
			name = "background"
			quadTextureSprite = "GFX_inner_circle_decor_bg"
		}
		iconType = {
			name = "yan_court_spotlight"
			spriteType = "GFX_spotlight_overlay"
			orientation = upper_left
			position = { x = 23 y = 24 }
			alwaystransparent = yes
		}


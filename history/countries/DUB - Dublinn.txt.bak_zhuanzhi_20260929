oob = "DUB_Start"

# ── 编制锁：深池只能造「死火行尸师」这一档 ──
# 顺序有讲究：先挂科技与 oob（模板要存在、兵种要可用），再全国锁，最后单独把这一档解回来。
# country_lock_all_division_template = yes 挡住"新建/改模板"，
# set_division_template_lock 决定某一档模板当下能不能用（RHL 外勤部队就是这么锁的）。
country_lock_all_division_template = yes
set_division_template_lock = {
	division_template = "死火行尸师"
	is_locked = no
}


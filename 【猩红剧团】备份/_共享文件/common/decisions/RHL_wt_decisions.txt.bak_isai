# 注意：本文件顶层块名 = 决议分类名，块内只能放「决议」。
# 分类自身的外观/可见性/优先级一律写在
# common/decisions/categories/RHL_wt_decisions_categories.txt，
# 不要在这里重复声明 icon / allowed / visible_when_empty / priority
# —— 引擎会把它们当作未知 token 报错（visible_when_empty 处解析中断）。
RHL_wt_decisions = {

	# ══════════ 转入战时体制（战时国策树入口） ══════════
	# 前置条件：莱茵生命、时间 1100 年及以后、处于非和平状态、人类玩家（is_ai = no）。
	# 完成效果：置旗标 RHL_wt_active + 载入战时国策树 RHL_wt。
	# 之所以用决议而不是自动切换：本引擎一次只显示一棵树，
	# load_focus_tree 会把正在点的十科树 RHL_td 顶掉（已完成的国策保留），
	# 交给玩家自己挑时机更稳妥（同 RHL_td_decision_enable 的既有惯例）。
	RHL_wt_decision_truth = {
		icon = GFX_decision_generic_national_unity
		cost = 0
		fire_only_once = yes
		allowed = {
			is_ai = no
		}
		visible = {
			is_ai = no
			date > 1099.12.31
			has_war = yes
			NOT = {
				has_country_flag = RHL_wt_active
			}
		}
		available = {
			is_ai = no
			date > 1099.12.31
			has_war = yes
			NOT = {
				has_country_flag = RHL_wt_active
			}
		}
		complete_effect = {
			custom_effect_tooltip = RHL_wt_tt_unlock_tree
			set_country_flag = RHL_wt_active
			load_focus_tree = {
				tree = RHL_wt
				keep_completed = yes
			}
		}
		ai_will_do = {
			factor = 0
		}
	}

	# ══════════ 加载战时国策树（玩家专属） ══════════
	# 与「真理终将得胜！」是同一个入口效果（置旗标 + load_focus_tree），
	# 区别只有两点：
	#   1) 本决议 is_ai = no —— 只有人类玩家能看见、能点（本 mod 惯用写法，
	#      见 common/decisions/Development_Decisions.txt 的 allowed = { is_ai = no }、
	#      common/decisions/East_Ursus_Decisions.txt 同款）；
	#   2) 不带时间与战争前置，随时可用于查看/测试战时国策树。
	# 两条决议靠 RHL_wt_active 互斥：用过任意一条，另一条自动消失。
	RHL_wt_decision_load_tree = {
		icon = GFX_decision_generic_research
		cost = 0
		fire_only_once = yes
		allowed = {
			is_ai = no
		}
		visible = {
			is_ai = no
			NOT = {
				has_country_flag = RHL_wt_active
			}
		}
		available = {
			is_ai = no
			NOT = {
				has_country_flag = RHL_wt_active
			}
		}
		complete_effect = {
			custom_effect_tooltip = RHL_wt_tt_unlock_tree
			set_country_flag = RHL_wt_active
			load_focus_tree = {
				tree = RHL_wt
				keep_completed = yes
			}
		}
		ai_will_do = {
			factor = 0
		}
	}

	# ══════════ 启动人造源石风暴 ══════════
	# 解锁条件：终局国策「莱茵战争机器」完成。
	# 可用条件：任一交战国投降度 > 50%（战局已定）。
	# 完成效果：对所有交战国的首都引爆人造源石风暴（bathe_in_hellfire_nuclear）
	#           并留下 730 天原子辐射（fallout_atomic）。
	# 写法照抄本 mod 既有先例：common/national_focus/SCR.txt 的 SCR_dream_of_scorched_earth
	#           （bathe_in_hellfire_nuclear + add_dynamic_modifier = { modifier = fallout_atomic }）。
	RHL_wt_decision_originium_storm = {
		icon = GFX_decision_generic_dangerous_deal
		cost = 0
		fire_only_once = yes
		visible = {
			has_country_flag = RHL_wt_flag_war_machine
		}
		available = {
			has_country_flag = RHL_wt_flag_war_machine
			any_country = {
				is_at_war_with = ROOT
				surrender_progress > 0.5
			}
		}
		complete_effect = {
			custom_effect_tooltip = RHL_wt_tt_originium_storm
			hidden_effect = {
				every_country = {
					limit = {
						is_at_war_with = ROOT
					}
					every_owned_state = {
						limit = {
							is_capital = yes
						}
						bathe_in_hellfire_nuclear = yes
					}
					add_dynamic_modifier = {
						modifier = fallout_atomic
						days = 730
					}
				}
			}
		}
		ai_will_do = {
			factor = 0
		}
	}
}

######################
## 大炎 第二国策树 · 岁醒（暂隐藏，仅决议可载入） ##
## 入口：决议 YAN_decision_suixing_preview「体验未完善内容」（岁陵司分类） ##
######################
#
# 【触发】本树暂不自动开放：country 因子为 0（不给 YAN 加权），引擎不会选中它；
#         唯一入口是决议「体验未完善内容」——它置旗标、load_focus_tree = YAN_suixing 并弹 yan_sui.5。
# 【回收】「大狩维天」完成后交回主树 YAN_national_focus 并清旗标，决议可再次使用。
# 【解锁】根国策仍留苏醒度门槛（yan_sui_awakening > 69）；若只想体验内容，
#         可把下面 YAN_suixing 的 available 临时注释掉。
# 【主题】猎杀巨兽「岁」及其傀儡、奴仆与造物。
# 【耗时】全树国策统一 cost = 1（1 周 = 7 天），16 格走完约 112 天。
# 【版式】左右两条支线镜像对称（x = -3/-2/-1 ←→ +1/+2/+3），行 4 各汇成一格，
#         行 6 合于最终国策「大狩维天」。全树 7 列 × 7 行，共 16 个国策。
#
#   左支「猎岁·本体」：岁陵封禁 →〔地脉截流 · 不反再铸〕→〔梦域反制 · 岁陵攻坚〕→ 斩岁之剑 → 真龙亲征
#   右支「清傀·造物」：伥物肃清 →〔器侑销熔 · 字侑封笔〕→〔墨魉焚卷 · 界园镇抚〕→ 山海众问罪 → 代理人甄别
#                              ↘ 两条支线尾汇入「大狩维天」↗
#
######################

focus_tree = {
	id = YAN_suixing

	country = {
		factor = 0	# 隐藏：不给任何 tag 加权，引擎不会自动选中本树，只能由决议 load_focus_tree 载入

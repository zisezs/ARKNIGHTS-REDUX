			OR = {
				# 岁兽苏醒度顶到岁陵撑不住
				check_variable = { yan_sui_awakening > 79 }
				# 或者拖到 1103 年，司岁台再压不住，决战自动开启
				date > 1103.1.1
			}
		}

		completion_reward = {
			add_dynamic_modifier = { modifier = YAN_route_sui }
			add_to_variable = { var = YAN_route_sui_stability_var value = 0.05 }
			add_to_variable = { var = YAN_route_sui_research_var value = 0.05 }
			add_to_variable = { var = YAN_route_sui_behemoth_var value = 0.05 }
			add_to_variable = { var = YAN_route_sui_intel_var value = 0.05 }
			add_to_variable = { var = YAN_route_sui_agent_unlock_var value = 1 }
			custom_effect_tooltip = YAN_route_sui_stability_p5_tt
			custom_effect_tooltip = YAN_route_sui_research_p5_tt
			custom_effect_tooltip = YAN_route_sui_behemoth_p5_tt
			custom_effect_tooltip = YAN_route_sui_intel_p5_tt
			custom_effect_tooltip = YAN_route_sui_agent_unlock_u1_tt

			if = {
				limit = { check_variable = { yan_agent_trust > 59 } }
				add_ideas = YAN_Wang_shackles
				add_ideas = YAN_New_sui_shadow
				add_ideas = YAN_Sui_calamity_ended
				custom_effect_tooltip = YAN_Suiling_Decisive_wang_tt
			}
			else_if = {
				limit = { check_variable = { yan_bufan_prep > 59 } }
				add_ideas = YAN_True_dragon_fallen
				add_ideas = YAN_Sui_calamity_ended
				custom_effect_tooltip = YAN_Suiling_Decisive_bufan_tt
			}
			else = {
				add_ideas = YAN_Sui_disaster
				add_ideas = YAN_Behemoths_awaken
				custom_effect_tooltip = YAN_Suiling_Decisive_fail_tt
			}
			country_event = { id = yan_sui.10 }
		}

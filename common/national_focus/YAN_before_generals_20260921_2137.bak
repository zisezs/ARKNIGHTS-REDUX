			if = {
				limit = { check_variable = { yan_agent_trust > 59 } }
				add_ideas = YAN_Wang_shackles
				add_ideas = YAN_New_sui_shadow
				add_ideas = YAN_Sui_calamity_ended
				custom_effect_tooltip = YAN_Suiling_Decisive_wang_tt
			}
			else_if = {
				limit = { check_variable = { yan_bufan_prep > 59 } }
				add_ideas = YAN_True_dragon_fallen
				add_ideas = YAN_Sui_calamity_ended
				custom_effect_tooltip = YAN_Suiling_Decisive_bufan_tt
			}
			else = {
				add_ideas = YAN_Sui_disaster
				add_ideas = YAN_Behemoths_awaken
				custom_effect_tooltip = YAN_Suiling_Decisive_fail_tt
			}
			country_event = { id = yan_sui.10 }
		}
	}


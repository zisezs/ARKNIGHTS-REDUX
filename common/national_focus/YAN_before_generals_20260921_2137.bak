######################
## 大炎 国策树 · 【岁相的荒唐梦】（2026-09-21 取代旧主树） ##
######################
#
# 【主题】真龙开阁，问十二位"能人异士"谁能入宰府。这是一场梦：十二个人都坐了进去。
#         ——"我原本期待，炎国将来的盛世图景中，也有你们十二人的位置。"（辞岁行）
#
# 【版式】全部节点使用绝对坐标 x/y。
#   【与岁同行】y 0..4：真龙与岁立约（根格）→ 盟书为证 → 岁片临朝 → 期限之约 → 送岁归陵；
#                      左支 借躯入世/镇岁能源/百城千舰/千岁之利，右支 划界之约/不干民命/岁怒之防/缄口之盟
#   军事簇   y 14..25 ：shared_focus 引用 YAN_military_shared.txt（本文件不占该区）
#   十二相   y 27..49 ：4 列 × 3 行，每块 3 列 × 7 行，块内 Δx=2、Δy=1，块间 Δx=12、Δy=8
#   收束带   y 51..55 ：望日之期 → 岁陵惊动 → 岁陵决战 → 八域不散 → 九州同举

# 【解锁】根格「与岁同行」完成 → 置旗 yan_sui_pact → 十二相 12 个出山格的 available 打开
#         （这就是"岁片国策树"的开关；出山格本身不写 prerequisite，避免跨 27 行的长连线）。
# 【无互斥】十二相全部可点，任何一格都不锁其它格（"荒唐梦"的玩法口径）。
# 【保号】YAN_Suiling_Stirring / YAN_Suiling_Decisive / YAN_Wang_replaces_Sui 三个旧 id
#         原样保留（事件 yan_sui.10 与既有脚本按 id 触发），前置改挂本树收束带。
# 【大BUFF】每人一枚 dynamic_modifier YAN_chc_<拼音>，数值写在变量里，三带各三档原地成长；
#           【与岁同行】另挂 YAN_sui_pact_reign（岁片临朝，送岁归陵时撤除）。
# 【生成器】E:/tmp/sui12/gen_dreamtree.js（改数据表重跑，勿手改产物）
#
######################

focus_tree = {
	id = YAN_national_focus

	country = {
		factor = 0
		modifier = {
			add = 10
			tag = YAN
		}
	}

	default = no


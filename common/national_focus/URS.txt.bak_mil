		y = 0
		cost = 2
		available_if_capitulated = yes
		ai_will_do = {
			factor = 10
		}

		completion_reward = {
			add_dynamic_modifier = { modifier = URS_ursus_shall_not_die }
			URS_Imperial_Court_Enable = yes
			set_country_flag = URS_economic_recovery_decisions_flag
			set_country_flag = URS_reform_conflict_open
			set_variable = { URS_shall_not_die_stability_var = -0.1 }
			custom_effect_tooltip = URS_tt_shall_not_die_stability_var_m10
			set_variable = { URS_shall_not_die_pp_var = -0.5 }

######################
## 乌萨斯帝国 · 政治国策树（整合改革线）##
## 皇帝线「皇帝陛下大展身手！」／ 议会线「王朝的终曲」／ 圣愚线「邪魔化运动」##
######################
#
# 25 个国策 = 共同起点 1 + 三线各 8。
# 旧的 1094 帝国会议 / 迈向未来两棵树（85 策）已下线，
# 备份在 docs/URS_旧树备份_20260915/。
#
# 【版式约定】全部节点使用绝对坐标 x/y（沿用 YAN 树约定，不用 relative_position_id）。
#
#   共同起点 病入膏肓 = (0, 0)
#   两条改革支线自起点左右镜像展开，列心 x = ∓12 → ∓9：
#     皇帝线（左）  皇帝的远征军 (-12,1) → 得加钱(-15,2) / 安德烈亚·多里安(-9,2)
#                   → 主线落在 x = -9，y = 3..7
#     议会线（右）  阿纳斯塔西娅的赠礼 (+12,1) → 初升的曙光(+12,2) → 一五计划(+12,3)
#                   → 重建圣骏堡(+15,4) / 大政变(+9,4) → 主线落在 x = +9，y = 5..7
#   圣愚线（中）    时间之前(0,9) … 时间之后(0,16)
#                   由「狂人的誓言」或「维特的独裁」汇入，构成“两翼失败坠入深渊”的构图。
#
# 【互斥】
#   皇帝线 · 大清洗     ↔  议会线 · 维特的独裁
#   议会线 · 大政变     ↔  议会线 · 维特的独裁
#
# 【圣愚线入口】时间之前（序曲）的 prerequisite 为「狂人的誓言」或「维特的独裁」，
#   另有 available 门槛：需先在决议面板完成「达莉娅的要求」（置 URS_darya_claim）。
#
# 【共享民族精神】URS_ursus_shall_not_die「乌萨斯还不能死！」
#   三条路线的零散小 BUFF 全部塞进这一个动态修正（common/dynamic_modifiers/
#   URS_dynamic_modifiers.txt），逐条 add_to_variable 原地成长；
#   圣愚线「时间之前（序曲）」把它换成 URS_ursus_demonic_campaign「乌萨斯邪魔化运动」
#   ——同一批变量、同一套数值，只换名字与图标。
#
# 【决议钩子】common/decisions/URS_Reform_Conflict_Decisions.txt
#   （分类 URS_reform_conflict_decisions「乌萨斯的改革矛盾」）
#   稳定议会／夺取议会 ← 初升的曙光 ｜ 冬季配给 ← 一五计划
#   新年后演讲 ← 何去何从 ｜ 达莉娅的要求 ← 两条线的终点国策
#   政变线与邪魔线的整合 ← 内卫被控
#
######################

focus_tree = {
	id = URS_political_reform

	country = {
		factor = 0
		modifier = {
			add = 10
			tag = URS
		}
	}

	default = no

	initial_show_position = {
		focus = URS_grave_illness
	}


	#1. 病入膏肓

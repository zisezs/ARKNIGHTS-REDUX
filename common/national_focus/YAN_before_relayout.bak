# ==============================================================================
#  大炎（YAN）国策树
#  · 起点「真龙临朝」下分 7 条线：政治 / 岁兽 / 军事 / 工业 / 科研 / 地方 / 外交
#  · 图标：关键节点用 GFX_focus_YAN_*（自绘徽章，见 interface/_ARF_goals/YAN_goals.gfx），
#          其余复用原版 GFX_focus_generic_*
#  · cost 为「周」（HOI4 国策 cost 单位），3 周 = 21 天
#  · 长期加成不散挂：每条线在里程碑发放/升级一个「路线大BUFF」
#    （YAN_Route_politics/sui/military/industry/research/local/diplomacy _1/_2/_3），
#    其余国策给一次性收益（PP / 陆军经验 / 建筑位 / 科研槽 / 变量）。
#  · 四大机制（岁兽苏醒度/书刀完整度/不反准备度/代理人信任）见
#    common/scripted_effects/YAN_scripted_effects.txt、common/decisions/YAN_Decisions.txt
# ==============================================================================

focus_tree = {
	id = YAN_national_focus

	country = {
		factor = 0
		modifier = {
			add = 10
			tag = YAN

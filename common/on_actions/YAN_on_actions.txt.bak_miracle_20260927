	#大炎四大机制月度结算（岁兽苏醒度上涨、阈值事件、书刀案、代理人离心、叛军循环等）
	#⚠️ 2026-09-21 修正：原来写成 on_monthly + every_country{original_tag = YAN}。
	#  on_monthly 在本引擎里**按现存国家各触发一次**（本 mod 场上 101 国 → 整段跑 101 遍，
	#  game.log 实证：1094.07.01 一个自然月里 "YAN_shanhai: 跳过本波" 打了 101 行）。
	#  旗标类的效果被去重掩盖了，但 add_to_variable 类不会：岁压每月 +1.5×101 直接顶回 100、
	#  苏醒度 +0.5×101 —— 等于【岁醒】整棵树的镇压全部被月度反扑抹平。
	#  改用原版口径的 on_monthly_YAN（就是"YAN 的国家作用域、每月一次"，
	#  与 common/on_actions/SRC_civilwar_on_actions.txt 的 on_monthly_SRC 同款）。
	on_monthly_YAN = {
		effect = {
			YAN_monthly_tick = yes

			# 珍玩集册：决议页入口面板直接显示 YAN_bonus_* / YAN_col_n* 的插值，
			# 而这些变量原本只在开面板·寻珍·看总览时重算 —— 老存档载入后到第一次点开
			# 面板之前会是空值。Recalc 是从旗标全量重算、不累加，所以每月跑一次是安全的。
			YAN_Collection_Recalc_Bonus = yes

			# 邪魔影响：与乌萨斯帝国作战时自动施加/解除
			if = {
				limit = {
					has_war_with = URS
					NOT = { has_idea = YAN_Xiemo_influence }
				}
				add_ideas = YAN_Xiemo_influence
			}
			else_if = {
				limit = {
					NOT = { has_war_with = URS }
					has_idea = YAN_Xiemo_influence
				}
				remove_ideas = YAN_Xiemo_influence
			}
		}
	}

# ============================================================================
# 本 mod 追加的战争目标类型
# （原版 common/wargoals/00_invasion.txt 未被 replace_path，两者并存加载）
#
# arf_take_all_core_states：
#   与 take_core_state 同义 —— 只索回「声明国自己的核心州」（is_core_of = ROOT）。
#   唯一区别是去掉了原版那条的 take_states_limit = 5：
#   卡西米尔有 25 个核心州，用原版 take_core_state 只会拿到 5 个，故单列一条。
#
# 用途：卡西米尔复国【极夜天曦】的第十二次乌卡战争。
#   只收回本土核心州，不吞并整个乌萨斯，好让乌萨斯系（整合运动等）仍能走
#   「东乌萨斯的统一 → 宣告乌萨斯统一」这条链。
# ============================================================================
wargoal_types = {

	arf_take_all_core_states = {
		# PREV = 目标国（乌萨斯）；ROOT = 索地国（卡西米尔）
		war_name = WAR_TAKE_CORE_NAME

		take_states = {
			is_core_of = ROOT
			is_owned_by = PREV
			is_controlled_by = PREV
		}

		generate_base_cost = 125
		generate_per_state_cost = 0

		take_states_cost = -80

		threat = 0.1
	}
}

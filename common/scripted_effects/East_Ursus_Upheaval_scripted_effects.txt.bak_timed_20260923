East_Ursus_Upheaval_Enable = {
	log = "[GetDateText]: [Root.GetName]: East_Ursus_Upheaval_Enable; Executing"

	# 2026-09-23：整段包一层「还没开过才开」，测试决议重复点时不再把混乱度/数组重置一遍
	if = {
		limit = { NOT = { has_country_flag = East_Ursus_Upheaval_Enabled } }

		custom_effect_tooltip = East_Ursus_Upheaval_Enable_Tt
		set_country_flag = East_Ursus_Upheaval_Enabled
		set_country_flag = East_Ursus_Upheaval_Focus_Enabled

		East_Ursus_Upheaval_Contenders_Setup = yes

		set_variable = { Upheaval_Chaos = 0.2 }
		set_variable = { Upheaval_Chaos_Progress = Upheaval_Chaos }
		multiply_variable = { Upheaval_Chaos_Progress = 100 }

		East_Ursus_Upheaval_Chaos_Modifier_Setup = yes

		hidden_effect = {
			add_dynamic_modifier = { modifier = East_Ursus_Upheaval_DynamicModifier_Chaos }
		}

		East_Ursus_Upheaval_Change_Color = yes

		set_variable = { ursus_warlord_original_capital = capital }

		# 自动混战的节奏变量（见文件末尾 East_Ursus_Upheaval_Auto_War_Loop）
		set_variable = { Upheaval_Auto_War_Timer = 0 }
		set_variable = { Upheaval_Auto_War_Picked = 0 }

		mark_focus_tree_layout_dirty = yes

		# 2026-09-23：ai_focus_aggressive_factor 不是效果（error.log 一直报 Unknown effect-type），删掉
	}

	log = "[GetDateText]: [Root.GetName]: East_Ursus_Upheaval_Enable; Finished execution"
}


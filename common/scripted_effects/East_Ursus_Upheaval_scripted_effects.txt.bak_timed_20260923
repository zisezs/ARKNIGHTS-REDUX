# 2026-09-23（第二处）：角逐者名册与三个计数改成每月整份重算。
# 旧写法只在 on_annex 里对 Num_1/Num_2 做 -1，而和会割地、内战建国、改 tag、
# 机制开启之后才冒出来的角逐者都不走 on_annex —— 计数一旦漂住，
# War_With_UEA 的「冻原上的角逐者打完了」和 AI 那条「本区只剩一个对手」就永久判错。
East_Ursus_Upheaval_Contenders_Setup = {
	East_Ursus_Upheaval_Refresh_Contenders = yes
}

East_Ursus_Upheaval_Refresh_Contenders = {
	# 「仍在机制内的角逐者」= 该国存在且带 East_Ursus_Upheaval_Enabled 旗标。
	# Num_1 = 全东乌萨斯；Num_2 = 与本方同区（东冻原 / 中冻原）；Real_Num = 带旗标者。
	# OnlyOneContenderLeft 触发器、宣战决议的 visible、结算决议都读这三个。
	hidden_effect = {
		if = {
			limit = { has_variable = Upheaval_Contenders }
			clear_array = Upheaval_Contenders
		}
		set_variable = { Upheaval_Contenders_Num_1 = 0 }
		set_variable = { Upheaval_Contenders_Num_2 = 0 }
		set_variable = { Upheaval_ContendersReal_Num = 0 }
		if = {
			limit = { REU = { exists = yes } }
			add_to_variable = { Upheaval_Contenders_Num_1 = 1 }
			add_to_array = { Upheaval_Contenders = REU }
			if = {
				limit = { east_tundria_ursus = yes }
				add_to_variable = { Upheaval_Contenders_Num_2 = 1 }
			}
		}
		if = {
			limit = { SKH = { exists = yes } }
			add_to_variable = { Upheaval_Contenders_Num_1 = 1 }
			add_to_array = { Upheaval_Contenders = SKH }
			if = {
				limit = { east_tundria_ursus = yes }
				add_to_variable = { Upheaval_Contenders_Num_2 = 1 }
			}
		}
		if = {
			limit = { UFE = { exists = yes } }
			add_to_variable = { Upheaval_Contenders_Num_1 = 1 }
			add_to_array = { Upheaval_Contenders = UFE }
			if = {
				limit = { east_tundria_ursus = yes }
				add_to_variable = { Upheaval_Contenders_Num_2 = 1 }
			}
		}
		if = {
			limit = { KMG = { exists = yes } }
			add_to_variable = { Upheaval_Contenders_Num_1 = 1 }
			add_to_array = { Upheaval_Contenders = KMG }
			if = {
				limit = { central_tundria_ursus = yes }
				add_to_variable = { Upheaval_Contenders_Num_2 = 1 }
			}
		}
		if = {
			limit = { BAK = { exists = yes } }
			add_to_variable = { Upheaval_Contenders_Num_1 = 1 }
			add_to_array = { Upheaval_Contenders = BAK }
			if = {
				limit = { central_tundria_ursus = yes }
				add_to_variable = { Upheaval_Contenders_Num_2 = 1 }
			}
		}
		if = {
			limit = { SGT = { exists = yes } }
			add_to_variable = { Upheaval_Contenders_Num_1 = 1 }
			add_to_array = { Upheaval_Contenders = SGT }
			if = {
				limit = { central_tundria_ursus = yes }
				add_to_variable = { Upheaval_Contenders_Num_2 = 1 }
			}
		}
		if = {
			limit = { OMN = { exists = yes } }
			add_to_variable = { Upheaval_Contenders_Num_1 = 1 }
			add_to_array = { Upheaval_Contenders = OMN }
			if = {
				limit = { central_tundria_ursus = yes }
				add_to_variable = { Upheaval_Contenders_Num_2 = 1 }
			}
		}
		if = {
			limit = { NAX = { exists = yes } }
			add_to_variable = { Upheaval_Contenders_Num_1 = 1 }
			add_to_array = { Upheaval_Contenders = NAX }
			if = {
				limit = { central_tundria_ursus = yes }
				add_to_variable = { Upheaval_Contenders_Num_2 = 1 }
			}
		}
	}
	East_Ursus_Upheaval_Count_Flagged_Contenders = yes
}



			NOT = { original_tag = UFE }
			NOT = { has_war_with = UFE }
			is_neighbor_of = UFE
			UFE = {
				exists = yes
				has_country_flag = East_Ursus_Upheaval_Enabled
				NOT = { is_subject_of = ROOT }
				is_subject = no
			}
		}
		set_variable = { Upheaval_Auto_War_Picked = 1 }
		log = "[GetDateText]: [Root.GetName]: EUU 自动备战 → UFE"
		activate_decision = East_Ursus_Upheaval_War_With_UFE
	}

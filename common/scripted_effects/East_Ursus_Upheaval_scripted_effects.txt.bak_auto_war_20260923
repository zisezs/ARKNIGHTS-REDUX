# ==============================================================================
# 角逐者自动混战（2026-09-22）
#
# on_monthly 对每个仍带 East_Ursus_Upheaval_Enabled 旗标的国家各跑一次。
# 需求：每个角逐者定期对其余角逐者宣战，直到只剩一个角逐者为止。
#
# 只靠原有的 East_Ursus_Upheaval_War_With_X 决议为什么不够：
#   · 那些决议的 visible 要求 AI「has_war = no」，只要角逐者被区外势力（帝国 / 玩家 /
#     乌卡战争）拖住，整场混战就永久卡死；
#   · 还要求 is_neighbor_of，隔着第三方领地的两个角逐者永远打不到一起；
#   · War_With_UFE 当时还漏了本区放行分支，东冻原内部根本打不到科雷马。
#
# 三级递进，节奏由 Upheaval_Auto_War_Timer（单位：月）控制：
#   T1 本区对手且全国无战事 → 走原备战决议（25 PP + 15 天备战 + 和议后 120 天冷却）
#   T2 本区没有可打的 → 任何接壤的角逐者，直接 annex_everything 宣战
#   T3 僵持超过 6 个月（互不接壤的死局）→ 无视邻接，随机挑一个还活着的角逐者宣战
# 只剩一个角逐者（Upheaval_ContendersReal_Num <= 1）时整条循环自动失效。
# ==============================================================================

East_Ursus_Upheaval_Auto_War_Loop = {
	if = {
		limit = {
			is_ai = yes
			exists = yes
			has_country_flag = East_Ursus_Upheaval_Enabled
			NOT = { has_country_flag = East_Ursus_Upheaval_preparing_expansion }	# 已有备战在跑，等它跑完
			check_variable = { Upheaval_ContendersReal_Num > 1 }	# 只剩一个角逐者就不再auto开战
		}

		if = {
			limit = { NOT = { has_variable = Upheaval_Auto_War_Timer } }
			set_variable = { Upheaval_Auto_War_Timer = 0 }	# 兼容机制开启后才加上的旧存档
		}

		# 已经和某个角逐者打着 → 不另开战线，计时清零，等这一仗打完
		if = {
			limit = {
				OR = {
					has_war_with = REU
					has_war_with = SKH
					has_war_with = UFE
					has_war_with = KMG
					has_war_with = BAK
					has_war_with = SGT
					has_war_with = OMN
					has_war_with = NAX
				}
			}
			set_variable = { Upheaval_Auto_War_Timer = 0 }
		}
		else = {
			add_to_variable = { Upheaval_Auto_War_Timer = 1 }

			if = {
				limit = { check_variable = { Upheaval_Auto_War_Timer > 2 } }
				set_variable = { Upheaval_Auto_War_Picked = 0 }

				# ---- T1：本区对手，走原备战决议（保持作者的 15 天备战节奏）----
				if = {
					limit = { has_war = no }
					if = {
						limit = { east_tundria_ursus = yes }
						East_Ursus_Upheaval_Auto_War_Prep_East = yes
					}
					else_if = {
						limit = { central_tundria_ursus = yes }
						East_Ursus_Upheaval_Auto_War_Prep_Central = yes
					}
				}

				# ---- T2：本区没人可打（已亡 / 已交火 / 不接壤 / 冷却中）→ 接壤即宣战 ----
				if = {
					limit = { NOT = { check_variable = { Upheaval_Auto_War_Picked = 1 } } }
					if = {
						limit = { east_tundria_ursus = yes }
						East_Ursus_Upheaval_Auto_War_Near_East = yes
						East_Ursus_Upheaval_Auto_War_Near_Central = yes
					}
					else_if = {
						limit = { central_tundria_ursus = yes }
						East_Ursus_Upheaval_Auto_War_Near_Central = yes
						East_Ursus_Upheaval_Auto_War_Near_East = yes
					}
					else = {
						East_Ursus_Upheaval_Auto_War_Near_East = yes
						East_Ursus_Upheaval_Auto_War_Near_Central = yes
					}
				}

				# ---- T3：僵持半年以上，说明剩下的人都互不接壤，硬开一仗把局推动 ----
				if = {
					limit = {
						NOT = { check_variable = { Upheaval_Auto_War_Picked = 1 } }
						check_variable = { Upheaval_Auto_War_Timer > 6 }
					}
					random_other_country = {
						limit = {
							ursus_unifier = yes
							exists = yes
							has_country_flag = East_Ursus_Upheaval_Enabled
							NOT = { is_subject_of = ROOT }
							NOT = { is_in_faction_with = ROOT }
							ROOT = { NOT = { has_war_with = PREV } }
						}
						save_event_target_as = EUU_auto_war_last_target
						ROOT = {
							set_variable = { Upheaval_Auto_War_Picked = 1 }
							set_variable = { Upheaval_Auto_War_Timer = 0 }
							log = "[GetDateText]: [Root.GetName]: EUU 僵持兜底宣战"
							declare_war_on = {
								target = EUU_auto_war_last_target
								type = annex_everything
							}
						}
					}
				}
			}
		}
	}
}

# T1：东冻原内部（REU / SKH / UFE 互为对手），逐条对齐原决议的 visible/available，
#     否则 activate_decision 会静默失败、白占一次机会。
East_Ursus_Upheaval_Auto_War_Prep_East = {
	if = {
		limit = {
			NOT = { check_variable = { Upheaval_Auto_War_Picked = 1 } }
			NOT = { original_tag = REU }
			NOT = { original_tag = UFE }	# War_With_REU：科雷马要先解决萨坎哈
			NOT = { has_war_with = REU }
			is_neighbor_of = REU
			REU = {
				exists = yes
				has_country_flag = East_Ursus_Upheaval_Enabled
				NOT = { is_subject_of = ROOT }
			}
		}
		set_variable = { Upheaval_Auto_War_Picked = 1 }
		log = "[GetDateText]: [Root.GetName]: EUU 自动备战 → REU"
		activate_decision = East_Ursus_Upheaval_War_With_REU
	}
	if = {
		limit = {
			NOT = { check_variable = { Upheaval_Auto_War_Picked = 1 } }
			NOT = { original_tag = SKH }
			NOT = { has_war_with = SKH }
			is_neighbor_of = SKH
			SKH = {
				exists = yes
				has_country_flag = East_Ursus_Upheaval_Enabled
				NOT = { is_subject_of = ROOT }
			}
			# War_With_SKH 的 available：科雷马要等萨坎哈坐大（占 202 或 REU_SKH_War 已满 150 天）
			OR = {
				NOT = { original_tag = UFE }
				SKH = {
					OR = {
						controls_state = 202
						has_country_flag = {
							flag = REU_SKH_War
							days > 150
						}
					}
				}
			}
		}
		set_variable = { Upheaval_Auto_War_Picked = 1 }
		log = "[GetDateText]: [Root.GetName]: EUU 自动备战 → SKH"
		activate_decision = East_Ursus_Upheaval_War_With_SKH
	}
	if = {
		limit = {
			NOT = { check_variable = { Upheaval_Auto_War_Picked = 1 } }
			NOT = { original_tag = UFE }
			NOT = { has_war_with = UFE }
			is_neighbor_of = UFE
			UFE = {
				exists = yes
				has_country_flag = East_Ursus_Upheaval_Enabled
				NOT = { is_subject_of = ROOT }
			}
		}
		set_variable = { Upheaval_Auto_War_Picked = 1 }
		log = "[GetDateText]: [Root.GetName]: EUU 自动备战 → UFE"
		activate_decision = East_Ursus_Upheaval_War_With_UFE
	}
}


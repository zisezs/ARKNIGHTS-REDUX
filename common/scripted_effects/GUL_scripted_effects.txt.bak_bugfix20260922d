#转移工厂
vic_factory_back_effect0 = {
	hidden_effect = {
		set_variable = { VIC.gul_mils_back = 0 }
		set_variable = { VIC.gul_civs_back = 0 }
		every_state = {
			limit = {
				has_dynamic_modifier = {
					modifier = vic_ocup_civ_state_modifier
					scope = VIC
				}
			}
			add_to_variable = { VIC.gul_civs_back = THIS.vic_ocup_civs_num_var }
		}
		every_state = {
			limit = {
				has_dynamic_modifier = {
					modifier = vic_ocup_mils_state_modifier
					scope = VIC
				}
			}
			add_to_variable = { VIC.gul_mils_back = THIS.vic_ocup_mils_num_var }
		}
		set_variable = { slot_var = VIC.gul_mils_back }
		add_to_variable = { slot_var = VIC.gul_civs_back }
	}
}
vic_factory_back_effect1 = {
	add_extra_state_shared_building_slots = VIC.slot_var
	if = {
		limit = { check_variable = { VIC.gul_civs_back > 0 } }

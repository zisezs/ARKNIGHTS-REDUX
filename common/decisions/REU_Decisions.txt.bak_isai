REU_Base_Construction_Decisions_GUI = {

	REU_Third_Army_Searching = {
		icon = GFX_decision_generic_political_discourse

		fire_only_once = yes

		available = {
			always = no
		}

		activation = {
			has_country_flag = REU_Base_Construction_Begin
		}

		is_good = no

		days_mission_timeout = 520

		priority = 500

		timeout_effect = {
			hidden_effect = {
				set_country_flag = REU_Exterminate_start
				unlock_national_focus = REU_The_first_Congress
				mark_focus_tree_layout_dirty = yes
				country_event = {
					id = event_reu.49
				}
			}
		}
	}

	REU_Search_Supplies = {
		icon = GFX_decision_generic_political_discourse

		cancel_trigger = {
			has_country_flag = REU_March_Begin
		}

		activation = {
			hidden_trigger = {
				always = no
			}
		}

		is_good = yes

		priority = 500
		days_mission_timeout = 30

		cancel_trigger = {
			has_country_flag = REU_March_Begin
		}

		timeout_effect = {
			set_temp_variable = { spl = REU_search_supplies_num }
			REU_Base_Construction_Supplies_Add = yes
			custom_effect_tooltip = redo_this_mission_decision_tt
			hidden_effect = {
				activate_mission = REU_Search_Supplies
			}
		}
	}

	REU_rapid_march = {
		icon = GFX_decision_generic_political_discourse

		available = {
			always = no
		}

		visible = {
			has_country_flag = REU_March_Begin
		}

		activation = {
			has_country_flag = REU_March_Begin
		}

		is_good = yes

		days_mission_timeout = 60

		priority = 500

		timeout_effect = {
			hidden_effect = {
				annex_country = {
					target = BWS
				}
				set_capital = {
					state = 251
					remember_old_capital = no
				}

				131 = {
					teleport_armies = {
						limit = {
							original_tag = REU
						}
						to_state = 232
					}
				}

				clr_country_flag = REU_March_Begin
				clr_country_flag = REU_Exterminate_start
				set_country_flag = REU_March_End
		
				if = {
					limit = {
						NOT = {
							OR = {
								has_completed_focus = REU_Light_Pack
								has_completed_focus = REU_Take_Everything
							}
						}
					}
					unlock_national_focus = REU_Light_Pack
				}
				if = {
					limit = {
						NOT = {
							OR = {
								has_completed_focus = REU_whole_to_parts
								has_completed_focus = REU_Avoid_involvement
							}
						}
					}
					unlock_national_focus = REU_whole_to_parts
				}
				complete_national_focus = REU_enter_Blagoveshchensk
				news_event = {
					id = worldnews_reu.2
				}
			}
		}
	}


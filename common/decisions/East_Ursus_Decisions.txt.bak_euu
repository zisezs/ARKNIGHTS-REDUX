central_tundria_trade_dispute_decisions = {

	central_tundria_trade_dispute_running = {

		icon = GFX_decision_generic_political_discourse

		available = {
			always = no
		}
		
		activation = {
			has_country_flag = central_tundria_trade_dispute_flag
		}

		priority = 1000
		days_mission_timeout = 200
		is_good = no

		timeout_effect = {
			if = {
				limit = {
					check_variable = {
						KMG.trade_influence > BAK.trade_influence
					}
				}
				KMG = {
					country_event = {
						id = event_kmg.7
					}
					annex_country = {
						target = KRS
						transfer_troops = yes
					}
					every_owned_state = {
						limit = { is_core_of = KRS }
						add_core_of = PREV
						remove_core_of = KRS
					}
				}
			}
			else_if = {
				limit = {
					check_variable = {
						KMG.trade_influence < BAK.trade_influence
					}
				}
				KMG = {
					country_event = {
						id = event_kmg.8
					}
				}
				BAK = {
					annex_country = {
						target = KRS
						transfer_troops = yes
					}
					every_owned_state = {
						limit = { is_core_of = KRS }
						add_core_of = PREV
						remove_core_of = KRS
					}
				}
			}
			else = {
				limit = {
					check_variable = {
						KMG.trade_influence = BAK.trade_influence
					}
				}
				random_list = {
					50 = {
						KMG = {
							country_event = {
								id = event_kmg.7
							}
							annex_country = {
								target = KRS
								transfer_troops = yes
							}
							every_owned_state = {
								limit = { is_core_of = KRS }
								add_core_of = PREV
								remove_core_of = KRS
							}
						}
					}
					50 = {

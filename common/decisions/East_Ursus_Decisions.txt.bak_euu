East_Ursus_test_Decisions = {
    East_Ursus_test_Upheaval_Begin = {
        allowed = {
            ursus_unifier = yes
}

        complete_effect = {
			East_Ursus_Upheaval_Enable = yes
		}
    }

    East_Ursus_test_Upheaval_End = {
        allowed = {
            ursus_unifier = yes
}

        complete_effect = {
			East_Ursus_Upheaval_Disable = yes
		}
    }

	East_Ursus_test_Upheaval_Region_Enable = {
		icon = GFX_decision_generic_welfare
		complete_effect = {
			if = {
				limit = { east_tundria_ursus = yes }
				REU = {
					if = { limit = { NOT = { has_country_flag = East_Ursus_Upheaval_Enabled } } }
					East_Ursus_Upheaval_Enable = yes
				}
				SKH = {
					if = { limit = { NOT = { has_country_flag = East_Ursus_Upheaval_Enabled } } }
					East_Ursus_Upheaval_Enable = yes
				}
				UFE = {
					if = { limit = { NOT = { has_country_flag = East_Ursus_Upheaval_Enabled } } }
					East_Ursus_Upheaval_Enable = yes
				}
			}
			else_if = {
				limit = { central_tundria_ursus = yes }
				KMG = {
					if = { limit = { NOT = { has_country_flag = East_Ursus_Upheaval_Enabled } } }
					East_Ursus_Upheaval_Enable = yes
				}

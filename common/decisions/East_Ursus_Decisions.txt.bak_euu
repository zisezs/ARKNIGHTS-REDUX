	Upheaval_Chaos_Gain = {

		icon = GFX_decision_generic_political_rally

		available = { hidden_trigger = { always = no } }

		activation = {
			OR = {
				has_country_flag = East_Ursus_Upheaval_Enabled
				has_country_flag = East_Ursus_Upheaval_2_Enabled
			}
		}

		priority = 100

		is_good = no

		days_mission_timeout = 7

		timeout_effect = {
			set_temp_variable = { Y = 0.02 }
			if = {
				limit = { has_war = yes }
				multiply_temp_variable = { Y = 1.5 }
			}
			East_Ursus_Upheaval_Chaos_Add_Y = yes
			if = {
				limit = {
					AND = {
						NOT = {
							controls_state = var:ursus_warlord_original_capital
						}
						NOT = {
							has_idea = upheaval_capital_lost
						}
					}
				}
				add_ideas = upheaval_capital_lost
			}
		}

		cancel_trigger = { 
			East_Ursus_Upheaval_ScriptedTrigger_OnlyOneContenderLeft = yes
		}
	}


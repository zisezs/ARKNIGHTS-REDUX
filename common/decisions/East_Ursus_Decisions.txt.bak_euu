East_Ursus_Upheaval_Decisions_GUI = {

	Upheaval_Occupation_UTA = {

		icon = GFX_decision_generic_colonial_administration
		visible = {
			OR = {
				original_tag = REU
				original_tag = SKH
			}
		}
		cost = 25

		fire_only_once = yes
		complete_effect = {
			custom_effect_tooltip = East_Ursus_Upheaval_Occupation_UTA_Tt
			set_temp_variable = { Y = -0.1 }
			East_Ursus_Upheaval_Chaos_Add_Y = yes
			add_command_power = UTA.command_power
			hidden_effect = {
				if = {
					limit = {
						original_tag = REU
					}
					transfer_state = 168
					transfer_state = 165
					transfer_state = 156
					country_event = {
						id = event_reu.93
					}
					hidden_effect = {
						news_event = {
							id = worldnews_reu.3
						}
					}
				}
				if = {
					limit = {
						original_tag = SKH
					}
					transfer_state = 131
					transfer_state = 98
					transfer_state = 63
				}
				FROM = {
					every_owned_state = {
						limit = { is_core_of = UTA }
						add_core_of = PREV
						remove_core_of = UTA
					}
				}
			}
		}

		ai_will_do = { factor = 1000 }
	}

	#加核心决议

	East_Ursus_KZM_war = {
		icon = GFX_decision_generic_political_discourse

		fire_only_once = yes

		available = {
			KZM = {
				OR = {
					is_puppet_of = ROOT
					exists = no
				}
			}
		}

		activation = {
			URS = { exists = no }
			has_war_with = KZM
		}

		is_good = no

		days_mission_timeout = 365

		priority = 500

		cancel_trigger = {
			surrender_progress > 0.25
			// 新链保险：仗一停就撤任务，免得到期 timeout 把割回的三地又送回去
			NOT = { has_war_with = KZM }
		}
		
		cancel_effect = {
			white_peace = KZM
			white_peace = KZC
			white_peace = BUS
			white_peace = BLT
			every_owned_state = {
				limit = {
					is_Ursus_Kozacy_area = yes
				}
				if = {
					limit = {
						KZC = { exists = yes }
					}
					transfer_state_to = KZC
				}
				else = {
					transfer_state_to = KZM
				}
			}
			every_owned_state = {
				limit = {
					is_Ursus_Belaursnia_area = yes
				}
				if = {
					limit = {
						BUS = { exists = yes }
					}
					transfer_state_to = BUS
				}
				else = {
					transfer_state_to = KZM
				}
			}
			every_owned_state = {
				limit = {
					is_Ursus_Balti_area = yes
				}
				if = {
					limit = {
						BLT = { exists = yes }
					}
					transfer_state_to = BLT
				}
				else = {
					transfer_state_to = KZM
				}
			}
		}

		timeout_effect = {
			white_peace = KZM
			white_peace = KZC
			white_peace = BUS
			white_peace = BLT
			every_owned_state = {
				limit = {
					is_Ursus_Kozacy_area = yes
				}
				if = {
					limit = {
						KZC = { exists = yes }
					}
					transfer_state_to = KZC
				}
				else = {
					transfer_state_to = KZM
				}
			}
			every_owned_state = {
				limit = {
					is_Ursus_Belaursnia_area = yes
				}
				if = {
					limit = {
						BUS = { exists = yes }
					}
					transfer_state_to = BUS
				}
				else = {
					transfer_state_to = KZM
				}
			}
			every_owned_state = {
				limit = {
					is_Ursus_Balti_area = yes
				}
				if = {
					limit = {
						BLT = { exists = yes }
					}
					transfer_state_to = BLT
				}
				else = {
					transfer_state_to = KZM
				}
			}
		}
	}


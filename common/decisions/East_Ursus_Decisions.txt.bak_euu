	#宣战决议
	# 2026-09-21 重制（本组 9 条由 docs/_ursus_war_decisions_rework.js 生成，勿手改单条）：
	#   · 修掉致命 bug：cancel_trigger 原为 NOT = { country_exists = X  has_war_with = X }，块内两条件是「与」，
	#     备战 15 天内既未亡国也未交战 → 条件恒真，决议点下去次日即被静默取消，玩家与 AI 都宣不出战。
	#   · 玩家不再受 has_war = no 与本区（东/中冻原）节奏限制，可同时对多个角逐者开战；AI 原样保留，免得多线崩盘。
	#   · 去掉 fire_only_once，改为 days_re_enable = 120：和议后对方仍在，冷却期过后可再宣。
	#   · 图标 generic_assault 在原版与本体 gfx 里都不存在（面板上是一片空白），改用 generic_military。

	East_Ursus_Upheaval_War_With_REU = {

		icon = GFX_decision_generic_military

		visible = {
			REU = { exists = yes }
			NOT = { tag = REU }
			is_neighbor_of = REU
			NOT = { has_war_with = REU }
			NOT = { REU = { is_subject_of = ROOT } }		#附庸走整合，不签宣战
			NOT = { original_tag = UFE }		#科雷马要先解决萨坎哈
			#玩家可多线开战、可跨区开战；AI 仍是一场仗一场仗地打，并保留本区节奏
			OR = {
				is_ai = no
				AND = {
					has_war = no
					OR = {
						east_tundria_ursus = yes
						check_variable = { Upheaval_Contenders_Num_2 = 1 }
					}
				}
			}
		}

		cost = 25

		modifier = {
			command_power_gain = -0.5
			political_power_gain = -1
		}

		complete_effect = {
			hidden_effect = {
				set_country_flag = East_Ursus_Upheaval_preparing_expansion
			}
		}

		days_remove = 15
		days_re_enable = 120		#和议后目标仍在，四个月内不能再宣

		remove_effect = {
			declare_war_on = { target = REU type = annex_everything }
			clr_country_flag = East_Ursus_Upheaval_preparing_expansion
			if = {
				limit = {
					original_tag = REU
				}
				SKH = {
					set_country_flag = REU_SKH_War
				}
			}
		}

		cancel_trigger = {		#目标已亡 / 已在交战才取消（原先写反，15 天备战期内恒真）
			hidden_trigger = {
				OR = {
					REU = { exists = no }
					has_war_with = REU
				}
			}
		}
		cancel_effect = {
			clr_country_flag = East_Ursus_Upheaval_preparing_expansion
		}

		ai_will_do = { #AI不会向多个军阀宣战
			factor = 1000
			modifier = {
				factor = 0
				has_country_flag = East_Ursus_Upheaval_preparing_expansion
			}
		}
	}

	East_Ursus_Upheaval_War_With_UFE = {

		icon = GFX_decision_generic_military

		visible = {
			UFE = { exists = yes }
			NOT = { tag = UFE }
			is_neighbor_of = UFE
			NOT = { has_war_with = UFE }
			NOT = { UFE = { is_subject_of = ROOT } }		#附庸走整合，不签宣战
			#玩家可多线开战、可跨区开战；AI 仍是一场仗一场仗地打，并保留本区节奏
			OR = {
				is_ai = no
				AND = {
					has_war = no
					check_variable = { Upheaval_Contenders_Num_2 = 1 }
				}
			}
		}

		cost = 25

		modifier = {
			command_power_gain = -0.5
			political_power_gain = -1
		}

		complete_effect = {
			hidden_effect = {
				set_country_flag = East_Ursus_Upheaval_preparing_expansion
			}
		}

		days_remove = 15
		days_re_enable = 120		#和议后目标仍在，四个月内不能再宣

		remove_effect = {
			declare_war_on = { target = UFE type = annex_everything }
			clr_country_flag = East_Ursus_Upheaval_preparing_expansion

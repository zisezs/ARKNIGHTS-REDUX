	East_Ursus_Unification = {
		visible = {
			OR = {
				AND = {
					NOT = {
						any_neighbor_country = {
							ursus_unifier = yes
						}
					}
					all_owned_state = {
						is_core_of = ROOT
					}
					UEA = {
						exists = no
					}
					CYB = {
						exists = no
					}
					IST = {
						exists = no
					}
				}
				# 2026-09-13：已是东乌萨斯仅存的角逐者 = 大叛乱已分出胜负，允许直接结算
				East_Ursus_Upheaval_ScriptedTrigger_OnlyOneContenderLeft = yes
			}
		}

		complete_effect = {
			East_Ursus_Upheaval_Disable = yes
			if = {
				limit = {
					original_tag = REU
				}
				set_province_name = {
					id = 1908
					name = vp_NovoTundriskaya
				}
				set_cosmetic_tag = Soviet_Republic_of_Tundria
			}
			if = {
				limit = {
					original_tag = KMG
				}
				set_province_name = {
					id = 1908
					name = vp_NovoTundriskaya
				}
				set_cosmetic_tag = National_Republic_of_Tundria
			}
			if = {
				limit = {
					original_tag = UFE
				}
				set_province_name = {
					id = 1908
					name = vp_NovoTundriskaya
				}
			}
			swap_ideas = {
				remove_idea = local_warlord
				add_idea = medium_country
			}
			add_research_slot = 1

			set_capital = {
				state = 139
				remember_old_capital = no
			}
		}

		ai_will_do = {
			factor = 1000
		}
	}	
}


######################################################
# 莱茵生命（RHL）· 作战 · 宣战决议（13 条）· 挨个点，一条打一国
# ──────────────────────────────────────────────────────────────
# 结构：本文件顶层块名 = 决议分类键，决议必须写在块内部（分类声明见
#       common/decisions/categories/RHL_war_categories.txt）。
#
# 可见条件：1098.1.1 且「泰拉平衡委员会」已成立（旗标 RHL_bal_faction_founded）。
# 目标清单（= 本 mod 有独立国策树的主要国家，共 13 个）：
#   维多利亚圈   VWI 维多利亚温德米尔边防集团军 / VIC 维多利亚帝国
#   乌萨斯圈     URS 乌萨斯帝国 / UFE 科雷马边疆区 / KMG 克缅哥罗德 / OMN 鄂姆诺达尔
#   西方         GUL 高卢共和国 / IBR 伊比利亚
#   新大陆       CLB 哥伦比亚联邦共和国 / ZZZ 废土
#   东方         YAN 大炎帝国
#   非国家行为体 SCR 猩红剧团 / REU 感染者游击队
#
# 引擎要点：
#   · declare_war_on = { target = X type = annex_everything } 是脚本效果，
#     直接开战、不经正当化流程 —— 因此不受本 mod 开局规则
#     allow_wargoals = FOCUSES_ONLY 的限制。（先例：common/decisions/East_Ursus_Decisions.txt）
#   · 目标国不存在或已与其交战时本条自动隐藏（visible 里判），战争结束后重新出现，
#     故本组决议**不写 fire_only_once**，可反复使用。
#   · 每条只花政治点，没有冷却；作战顺序完全由玩家自己决定。
#   · 【2026-09-14 新增】全 13 条都带「国力门槛」：available = { num_of_factories > 199 }
#     —— 工厂总数（民用+军用+船坞）不足 200 时决议仍可见、但点不动，
#     tooltip 显示「工业高于199」（vanilla 键 TRIGGER_NUM_OF_TOTAL_FACTORIES_MORE_THAN）。
#     ⚠ available 同样约束 AI；只想限制玩家就改成
#       available = { OR = { is_ai = yes  num_of_factories > 199 } }。
#
# AI 权重（2026-09-13 调整，详见 docs/_rhl_ai_priority.py / _rhl_war_ai_exclude.py）：
#   · 其中 9 条（VWI/VIC/URS/UFE/KMG/OMN/IBR/YAN/REU）ai_will_do = factor 10000 = AI 必定优先点；
#   · 另外 4 条（CLB/GUL/SCR/ZZZ）保持 base = 0 = **玩家专属**，因为它们在同一个目标上与
#     另外两套决议自相矛盾：CLB 撞「内科手术」全套（8 条都要求不与 CLB 交战，先宣战
#     会让并购链永久失效）、GUL/SCR 撞「邀请入阵营」（add_to_faction）、ZZZ 撞「废土军事通行权」。
#     若要让 AI 也打这 4 国，改回 factor 10000 即可，但 AI 会自我锁死。
#   · VIC 一条不写死 tag：见下方 RHL_war_vic 的说明。
######################################################

RHL_war = {

	# ═══════════════════════════ 一、维多利亚圈 ═══════════════════════════

	# ── 维多利亚温德米尔边防集团军（VWI） ──
	RHL_war_vwi = {
		icon = GFX_decision_generic_military

		cost = 50

		visible = {
			# [临时放宽] 验收用 —— 原为 1098 年门槛，还原请运行 _rhl_temp_dategate.py on
			date > 1094.6.1
			has_country_flag = RHL_bal_faction_founded
			VWI = { exists = yes }
			NOT = { has_war_with = VWI }
		}

		available = {
			# 国力门槛（2026-09-14）：工厂总数（民用+军用+船坞）< 200 时无法宣战
			# 该族触发器只认 > / <，故「≥200」写作 199
			num_of_factories > 199
		}

		complete_effect = {
			custom_effect_tooltip = RHL_war_vwi_tt
			hidden_effect = {
				declare_war_on = { target = VWI type = annex_everything }
			}
		}

		ai_will_do = {
			factor = 10000
		}
	}

	# ── 维多利亚帝国（不写死 TAG：以「谁控制伦蒂尼姆」判定） ──
	# 维多利亚帝国在本 mod 会 change_tag（events/VIC.txt 中 VIC → VWI / VCA / VGO / TAR 等），
	# 所以写死 target = VIC 会在内战后失效。改用动态判定：控制州 434（伦蒂尼姆）者
	# 即为当下的维多利亚帝国 —— 无论它当前 TAG 是什么。
	# 效果里先用 save_event_target_as 存下目标，再用 event_target: 宣战
	# （先例：原版 common/decisions/PRC.txt 的 target = event_target:WTT_current_china_leader）。
	RHL_war_vic = {
		icon = GFX_decision_generic_monarchy

		cost = 50

		visible = {
			# [临时放宽] 验收用 —— 原为 1098 年门槛，还原请运行 _rhl_temp_dategate.py on
			date > 1094.6.1
			has_country_flag = RHL_bal_faction_founded
			# 存在「控制伦蒂尼姆、且不是自己」的国家 —— 那就是当下的维多利亚帝国
			any_country = {
				controls_state = 434
				NOT = { tag = ROOT }
			}
			# 且尚未与它交战，避免重复点
			NOT = {
				any_country = {
					controls_state = 434
					NOT = { tag = ROOT }
					has_war_with = ROOT
				}
			}
		}

		available = {
			# 国力门槛（2026-09-14）：工厂总数（民用+军用+船坞）< 200 时无法宣战
			# 该族触发器只认 > / <，故「≥200」写作 199
			num_of_factories > 199
		}

		complete_effect = {
			custom_effect_tooltip = RHL_war_vic_tt
			hidden_effect = {
				# 兜底：执行瞬间再确认目标存在，避免 event_target 为空
				if = {
					limit = {
						any_country = {
							controls_state = 434
							NOT = { tag = ROOT }
						}
					}
					every_country = {
						limit = {
							controls_state = 434
							NOT = { tag = ROOT }
						}
						save_event_target_as = RHL_war_victoria_target
					}
					declare_war_on = {
						target = event_target:RHL_war_victoria_target
						type = annex_everything
					}
				}
			}
		}

		ai_will_do = {
			factor = 10000
		}
	}

	# ═══════════════════════════ 二、乌萨斯圈 ═══════════════════════════

	# ── 乌萨斯帝国（URS） ──
	RHL_war_urs = {
